GOOGLE_API_KEY=

# Optional. Without a token the Telegram bot is off.
TELEGRAM_BOT_TOKEN=
# Send /start to the bot and it replies with this number.
TELEGRAM_CHAT_ID=

# Optional. Without both, scored vacancies are not pushed to job-apply-tracker.
# The host name is the tracker container on the shared job-net network.
TRACKER_API_URL=http://job-apply-tracker:8000
# In the tracker repo: docker compose exec web python manage.py create_api_token <username>
TRACKER_API_TOKEN=
